# 複製成 .env.local（本機），或填到 Cloudflare Pages 的「設定 → 變數和祕密」（建置時讀取）。
# 全部留空也能建置：線上對戰會顯示「尚未設定」，其他模式照常。

# Firebase 專案設定 → 一般 → 你的應用程式 → SDK 設定與配置
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# 選用：講 USI 的 YaneuraOu Worker 腳本網址。設定後「設定」畫面會出現引擎選項。
VITE_YANEURAOU_URL=
