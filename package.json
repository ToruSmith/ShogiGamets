{
  "name": "shogi-games",
  "version": "1.0.0",
  "private": true,
  "description": "將棋：對電腦、雙人同機、線上對戰、詰將棋、復盤與賽後分析，可離線遊玩的 PWA。",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "generate:tsume": "node --import tsx scripts/generate-tsume.ts > src/core/tsume-data.ts",
    "generate:icons": "node scripts/generate-icons.mjs",
    "check": "npm run typecheck && npm run format:check && npm test && npm run build",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "playwright": "1.63.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.12",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase": "13.2.0",
    "lucide-react": "1.67.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  }
}
